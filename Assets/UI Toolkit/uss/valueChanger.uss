.btn {
    background-color: rgba(88, 88, 88, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.unity-label {
    -unity-text-align: middle-center;
    -unity-font-definition: resource('06_Fonts/Fastron SDF');
    font-size: 42px;
    color: rgb(237, 0, 140);
    background-color: rgb(26, 26, 26);
    height: 100%;
    max-height: 80px;
    min-height: 40px;
}

.definition {
    width: 40%;
}

.value-label {
}

#subtract:hover {
    border-left-color: rgb(0, 191, 243);
    border-right-color: rgb(0, 191, 243);
    border-top-color: rgb(0, 191, 243);
    border-bottom-color: rgb(0, 191, 243);
    border-left-width: 10px;
    border-right-width: 10px;
    border-top-width: 10px;
    border-bottom-width: 10px;
    transition-duration: 0.1s;
}

#add:hover {
    border-left-color: rgb(237, 0, 140);
    border-right-color: rgb(237, 0, 140);
    border-top-color: rgb(237, 0, 140);
    border-bottom-color: rgb(237, 0, 140);
    border-left-width: 10px;
    border-right-width: 10px;
    border-top-width: 10px;
    border-bottom-width: 10px;
    transition-duration: 0.1s;
}

.square-container {
    align-items: center;
    flex-grow: 1;
    justify-content: space-around;
    flex-direction: column;
}

.square {
    padding-top: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
}
