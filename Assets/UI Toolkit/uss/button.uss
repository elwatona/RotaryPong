.button {
    width: auto;
    min-width: 570px;
    min-height: 135px;
    max-width: 570px;
    max-height: 135px;
    font-size: 84px;
    -unity-font: resource('06_Fonts/NeutronsDemoRegular');
    -unity-font-definition: resource('06_Fonts/NeutronsDemoRegular SDF');
    -unity-text-align: lower-center;
    background-color: rgba(88, 88, 88, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(0, 191, 243);
}

.button:hover {
    width: auto;
    min-width: 570px;
    min-height: 135px;
    max-width: 570px;
    max-height: 135px;
    font-size: 84px;
    -unity-font: resource('06_Fonts/NeutronsDemoRegular');
    -unity-font-definition: resource('06_Fonts/NeutronsDemoRegular SDF');
    -unity-text-align: lower-center;
    background-color: rgba(88, 88, 88, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(237, 0, 140);
    border-right-color: rgb(237, 0, 140);
    border-top-color: rgb(237, 0, 140);
    border-bottom-color: rgb(237, 0, 140);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(0, 191, 243);
}

.button:active {
    width: auto;
    min-width: 570px;
    min-height: 135px;
    max-width: 570px;
    max-height: 135px;
    font-size: 84px;
    -unity-font: resource('06_Fonts/NeutronsDemoRegular');
    -unity-font-definition: resource('06_Fonts/NeutronsDemoRegular SDF');
    -unity-text-align: lower-center;
    background-color: rgba(88, 88, 88, 0);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-left-color: rgb(0, 191, 243);
    border-right-color: rgb(0, 191, 243);
    border-top-color: rgb(0, 191, 243);
    border-bottom-color: rgb(0, 191, 243);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    color: rgb(237, 0, 140);
}

.preset-button {
    max-width: 72px;
    max-height: 72px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    font-size: 42px;
    -unity-font-definition: resource('06_Fonts/Fastron SDF');
    -unity-font: resource('06_Fonts/Fastron');
    background-color: rgba(88, 88, 88, 0);
    flex-grow: 4;
    flex-shrink: 1;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-bottom-width: 5px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    -unity-text-align: middle-center;
    color: rgba(0, 191, 243, 255);
}
