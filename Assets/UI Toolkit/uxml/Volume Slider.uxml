<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/uss/volume.uss?fileID=7433441132597879392&amp;guid=58053c29722d04040aa6f205df192292&amp;type=3#volume" />
    <Style src="project://database/Assets/UI%20Toolkit/uss/style.uss?fileID=7433441132597879392&amp;guid=9f46565e3a7b5834b8f2269cecfb32bf&amp;type=3#style" />
    <ui:VisualElement name="base" style="flex-grow: 1; align-items: center; flex-direction: column; padding-left: 10px; padding-right: 10px; padding-top: 10px; padding-bottom: 10px; min-height: 135px; justify-content: space-around; width: 100%; height: 100%;">
        <ui:Label text="VOLUMEN" display-tooltip-when-elided="true" style="-unity-font-definition: resource(&apos;06_Fonts/NeutronsDemoRegular SDF&apos;); font-size: 100%; transform-origin: center; -unity-text-align: lower-center; width: auto; -unity-font-style: normal; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; justify-content: center; align-items: center; -unity-font: resource(&apos;06_Fonts/NeutronsDemoRegular&apos;); color: rgb(255, 255, 255); flex-grow: initial; height: 50%; flex-shrink: initial;" />
        <ui:VisualElement name="Bar" style="flex-direction: row; flex-grow: 2; align-items: center;">
            <ui:Button text="&lt;" display-tooltip-when-elided="true" name="prev" class="square-button" style="max-width: 48px; max-height: 48px;" />
            <ui:VisualElement name="background" style="border-left-color: rgb(237, 0, 140); border-right-color: rgb(237, 0, 140); border-top-color: rgb(237, 0, 140); border-bottom-color: rgb(237, 0, 140); flex-grow: 1; border-left-width: 10px; border-right-width: 10px; border-top-width: 10px; border-bottom-width: 10px; width: auto; align-items: stretch; height: 100%; flex-direction: row; background-color: rgb(0, 191, 243); min-height: auto; min-width: auto;">
                <ui:VisualElement name="filler" style="max-width: none; max-height: none; height: 100%; background-color: rgb(237, 0, 140); width: 80%;" />
            </ui:VisualElement>
            <ui:Button text="&gt;" display-tooltip-when-elided="true" name="next" class="square-button" style="width: 100%; height: 100%; max-width: 48px; max-height: 48px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
