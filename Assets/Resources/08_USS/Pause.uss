.pause{
    flex-direction: row;
    flex-grow: 1;
}

.pause__left{
    flex-direction: column;
    flex-grow: 2;
    align-items: flex-start;
}

.pause__right{
    flex-direction: column;
    flex-grow: 2;
    align-items: flex-end;
}

.pause__volumen-container{
    flex-basis: 70%;
    width: 20%;
}

.pause__btn-container{
    flex-basis: 30%;
    width: 55%;
    margin-left: 15px;
    margin-right: 15px;
}