.settings{
    flex-grow: 1;
    /* background-color: rgb(0,0,17); */
}

.settings__title{
    flex-basis: 30%;
    flex-grow: 3;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.settings__title--label{
    -unity-font: resource('06_Fonts/NeutronsDemoRegular');
    -unity-font-definition: resource('06_Fonts/NeutronsDemoRegular ASCII');
    font-size: 168px;
    width: 715px;
    height: 280px;
}

.settings__title--label_left{
    color: rgb(0, 191, 243);
    -unity-text-align: lower-right;
}

.settings__title--label_right{
    color: rgb(237, 0, 140);
    -unity-text-align: lower-left;
}

.settings__elements-container{
    flex-basis: 60%;
    flex-grow: 3;
    flex-direction: row;
    margin-bottom: 50px;
}

.setting__column{
    flex-basis: 20%;
    flex-grow: 3;
    align-items: stretch;
    justify-content: flex-start;
    margin-left: 7.5px;
    margin-right: 7.5px;
    margin-bottom: 0px;
    margin-top: 0px;
    padding: 0px;

}

.setting__element-title{    
    -unity-font: resource('06_Fonts/Fastron');
    -unity-font-definition: resource('06_Fonts/Fastron SDF');
    -unity-text-align: middle-center;
    color: rgb(237, 0, 140);
    margin: 0px;
    margin-bottom: 7.5px;
    font-size: 42px;
    background-color: rgb(26,26,26);
    max-height: 60px;  
}

.settings__element{
    margin-top: 2.5px;
    margin-bottom: 0px;
    margin-left: 0px;
    margin-right: 0px;
}

.unity-label {
    padding: 0px;
}

.unity-button {
    background-color: rgba(0,0,0,0);
}